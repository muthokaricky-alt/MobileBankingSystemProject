<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<Pane prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="wire.AdminDashboardController">
   <children>
      <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/background.jpg" />
         </image>
      </ImageView>
      
      <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20;" layoutX="50.0" layoutY="50.0" prefHeight="500.0" prefWidth="700.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Wire Admin Dashboard" style="-fx-text-fill: #2E8B57; -fx-font-weight: bold;">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="viewIncomeBtn" mnemonicParsing="false" onAction="#handleViewIncome" prefHeight="40.0" prefWidth="150.0" text="View Income" />
                  <Button fx:id="registerUserBtn" mnemonicParsing="false" onAction="#handleRegisterUser" prefHeight="40.0" prefWidth="150.0" text="Register User" />
                  <Button fx:id="viewUsersBtn" mnemonicParsing="false" onAction="#handleViewUsers" prefHeight="40.0" prefWidth="150.0" text="View Users" />
                  <Button fx:id="viewTransactionsBtn" mnemonicParsing="false" onAction="#handleViewTransactions" prefHeight="40.0" prefWidth="150.0" text="View Transactions" />
               </children>
            </HBox>
            
            <TextArea fx:id="reportArea" prefHeight="350.0" prefWidth="650.0" style="-fx-font-family: 'Monospaced'; -fx-font-size: 12;" />
            
            <Button fx:id="logoutBtn" mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="150.0" text="Logout" />
         </children>
      </VBox>
   </children>
</Pane>